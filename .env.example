# --- Payload ---
# Long random string; signs admin sessions.
PAYLOAD_SECRET=

# --- Supabase Postgres (new project) ---
# Use the "Session pooler" connection string from Supabase > Connect.
DATABASE_URI=

# --- Google Cloud Storage (leave GCS_BUCKET empty to store uploads on local disk) ---
GCS_BUCKET=
GCS_PROJECT_ID=
# The service-account key JSON on a single line.
GCS_CREDENTIALS=

# --- Resend (leave RESEND_API_KEY empty to log emails to the console) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Portfolio
# Fallback recipient for contact notifications if Site Settings has no contact email.
ADMIN_EMAIL=

# --- Cloudflare Turnstile (contact form and admin login) ---
# Leave both empty to switch the check off. For local development Cloudflare
# publishes test keys that always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- One-time migration only (scripts/migrate-legacy.ts) ---
# Connection string of the OLD Prisma database.
LEGACY_DATABASE_URL=
